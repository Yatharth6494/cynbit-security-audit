generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  CREATED
  PAID
  FULFILLED
  FAILED
  REFUNDED
  EXPIRED
}

enum DiaryStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  fullName     String
  passwordHash String?
  status       UserStatus   @default(PENDING_SETUP)
  setupTokens  SetupToken[]
  sessions     Session[]
  orders       Order[]
  auditEvents  AuditEvent[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model SetupToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Order {
  id               String      @id @default(cuid())
  provider         String      @default("cashfree")
  providerOrderId  String      @unique
  paymentSessionId String?
  amountMinor      Int
  currency         String
  status           OrderStatus @default(CREATED)
  email            String
  fullName         String
  phone            String
  university       String
  track            String
  duration         String
  referralName     String?
  ambitions        String      @db.Text
  userId           String?
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([email])
  @@index([status])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  payload         Json
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
}

model Outbox {
  id        String       @id @default(cuid())
  type      String
  status    OutboxStatus @default(PENDING)
  payload   Json
  attempts  Int          @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, createdAt])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  company   String?
  industry  String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model DiaryEntry {
  id        String      @id @default(cuid())
  fullName  String
  role      String
  email     String
  title     String
  story     String      @db.Text
  status    DiaryStatus @default(PENDING_REVIEW)
  createdAt DateTime    @default(now())

  @@index([status, createdAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
